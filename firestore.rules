rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Activity Logs Collection
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Content Collections: Projects, Equipment, Events, News, Distribution
    match /projects/{id} {
      allow read, write: if true;
    }

    match /equipment/{id} {
      allow read, write: if true;
    }

    match /events/{id} {
      allow read, write: if true;
    }

    match /news/{id} {
      allow read, write: if true;
    }

    match /distribution/{id} {
      allow read, write: if true;
    }

    // Enquiries Collection
    match /enquiries/{id} {
      allow read, write: if true;
    }

    // Site Settings & Appearance
    match /site_settings/{id} {
      allow read, write: if true;
    }

    // Media Collection
    match /media/{id} {
      allow read, write: if true;
    }
  }
}