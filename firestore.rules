rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCmsAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'praful.akhani19@gmail.com') ||
        (request.auth.uid != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
            'SUPER_ADMIN',
            'CONTENT_ADMIN',
            'EDITOR',
            'EQUIPMENT_MANAGER',
            'EVENT_MANAGER',
            'MARKETING_MANAGER'
          ]
        ))
      );
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'praful.akhani19@gmail.com') ||
        isCmsAdmin()
      );
    }

    // Activity Logs Collection
    match /activity_logs/{logId} {
      allow read: if isCmsAdmin();
      allow create: if isAuthenticated();
    }

    // Projects Collection
    match /projects/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Equipment Collection
    match /equipment/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Events Collection
    match /events/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // News Collection
    match /news/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Newsroom Collection
    match /newsroom/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Distribution Collection
    match /distribution/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Hero Slides Collection
    match /heroSlides/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Team Members Collection
    match /team/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Partners Collection
    match /partners/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Marketing Projects Collection
    match /marketingProjects/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Enquiries Collection
    match /enquiries/{id} {
      allow create: if true;
      allow read, write: if isCmsAdmin();
    }

    // Site Settings (site_settings)
    match /site_settings/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Brand Settings Collection (brandSettings)
    match /brandSettings/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Site Content Collection (siteContent)
    match /siteContent/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // SEO Settings Collection (seoSettings)
    match /seoSettings/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Custom Pages (Elementor Style Builder)
    match /customPages/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Navigation Menus (WordPress Style Menus)
    match /navigationMenus/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Theme Customizer Settings
    match /themeCustomizer/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Media Collection
    match /media/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }

    // Media Assignments Collection
    match /mediaAssignments/{id} {
      allow read: if true;
      allow write: if isCmsAdmin();
    }
  }
}
