rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Activity Logs Collection
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Content Collections: Projects, Equipment, Events, News, Distribution
    match /projects/{id} {
      allow read, write: if true;
    }

    match /equipment/{id} {
      allow read, write: if true;
    }

    match /events/{id} {
      allow read, write: if true;
    }

    match /news/{id} {
      allow read, write: if true;
    }

    match /newsroom/{id} {
      allow read, write: if true;
    }

    match /distribution/{id} {
      allow read, write: if true;
    }

    // Hero Slides Collection
    match /heroSlides/{id} {
      allow read, write: if true;
    }

    // Team Members Collection
    match /team/{id} {
      allow read, write: if true;
    }

    // Partners Collection
    match /partners/{id} {
      allow read, write: if true;
    }

    // Marketing Projects Collection
    match /marketingProjects/{id} {
      allow read, write: if true;
    }

    // Enquiries Collection
    match /enquiries/{id} {
      allow read, write: if true;
    }

    // Site Settings & Appearance
    match /site_settings/{id} {
      allow read, write: if true;
    }

    // Brand Settings Collection
    match /brandSettings/{id} {
      allow read, write: if true;
    }

    // Site Content Collection
    match /siteContent/{id} {
      allow read, write: if true;
    }

    // SEO Settings Collection
    match /seoSettings/{id} {
      allow read, write: if true;
    }

    // Media Collection - Public Read, Admin Write
    match /media/{id} {
      allow read, write: if true;
    }

    // Media Assignments Collection - Public Read, Admin Write
    match /mediaAssignments/{id} {
      allow read, write: if true;
    }
  }
}
